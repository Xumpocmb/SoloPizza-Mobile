{
  "expo": {
    "name": "Solo Pizza",
    "slug": "SoloPizzaMobileApp",
    "owner": "solopizzas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "by.solopizza.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "by.solopizza.app",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-vector-icons/material-icons",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.101927534807-s7ldodoqvid6qdvpcg5t78denkh8ua71"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a08a0318-74b0-4f7d-9865-5af705593274"
      }
    }
  }
}
